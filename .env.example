# LINE Messaging API（任意。未設定でも Web の URL 貼り付けは動きます）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# データ保存先（省略時は ./.data）
OKU_DATA_DIR=

# Cloudflare R2（4つ全部入れると R2 に保存。未設定なら ./.data）
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Clerk（Googleログイン。2つとも入れるとログイン必須になる。未設定ならログインなしで動く）
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# 任意: LINEカードの写真URLの署名用（未設定なら CLERK_SECRET_KEY を使う）
AUTH_SECRET=
